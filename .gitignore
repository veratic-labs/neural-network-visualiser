# Python virtual environment (multi-GB torch/CUDA install, machine specific)
venv/

# Local MNIST dataset — the loader downloads it on demand, never commit it
training/data/

# Model weights saved by training/training.py
training/weights/

# Training recordings written by recorder/record_training.py (tens of MB of
# regenerable binary data; Milestone 5C copies what it needs into docs/)
recordings/

# Python bytecode and caches
__pycache__/
*.py[cod]

# Windows metadata files WSL creates for files copied from Windows
*:Zone.Identifier

# Editor and OS noise
.DS_Store
.idea/
.vscode/
